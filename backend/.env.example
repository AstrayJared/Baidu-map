# Server-side AK only. Copy to .env locally; never commit .env.
BAIDU_MAP_AK=
# Production: OSM guidance plus Baidu detailed walking validation (Hybrid v1.5).
# QPS limits validation calls. synthetic is an offline test harness only.
ANALYSIS_PROVIDER=baidu
ANALYSIS_QPS=
# JSON array of exact origins, without trailing slashes.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# OSM is optional and must be selected with
# `python backend/scripts/setup_osm_region.py import <runtime.zip>`. Paths are relative to
# backend. The selected package is loaded on the first Hybrid request.
OSM_REGION_ID=
OSM_PBF_PATH=
OSM_GRAPH_CACHE_PATH=
OSM_DATA_VERSION=unconfigured
OSM_METRIC_CRS=EPSG:3857
WALK_SPEED_MPS=1.3
SNAP_MAX_DISTANCE_M=200
ISOCHRONE_BUFFER_M=25
OSM_COVERAGE_BOUNDARY_PATH=
OSM_COVERAGE_MARGIN_M=100
HYBRID_RISK_PATH=
HYBRID_OBSTACLE_PATH=
WATER_REVIEW_DIR=

# Durable /api/v2/checkups tasks and their immutable revisions. Relative paths
# are resolved against backend/. A restart marks unfinished tasks interrupted.
CHECKUP_DIR=.checkups

# Cross-task cache validity in seconds. Unset means a cached page, route or
# spatial result is reused only inside the task that stored it: no permanent
# storage and no permanently fresh entry by default. Set it only when the
# deployment's data-use agreement allows reuse across tasks.
CACHE_FRESHNESS_SECONDS=
# 同一片区域会被反复体检时，把它设成 3600（1 小时）是有意义的：同一页命中缓存不占用
# 任何地点检索额度，也不进入限流门。默认留空是按数据使用约定取的保守值，不是技术限制 ——
# 跨任务复用是一项部署决定。/api/v2/capabilities 的 cache 栏会报出当前生效值。
# 这一项直接决定"同一个位置重新体检"能不能接着用上一次取的页面：关着（默认）时新任务一页也
# 复用不到、会重新花一次额度；同一地点想接着查而不重新花钱，走原任务的补查接口（补查自带新
# 预算标识，复用该任务的缓存与圈面）。两者都只影响复用，不影响任何一次派发前的最终检查。
# 页面缓存是**进程内存**（capabilities 的 cache.processLocal 报出这一点）：重启即失效，
# 也不跨进程共享。所以"缓存命中"不等于数据永久有效，更不等于重启后能接着上次的进度查 ——
# 本轮不支持持久化断点续查。

# Per-service Baidu quota. The two services are separate pools, so one does not
# consume the other's allowance. Ceilings, not throughput promises: the existing
# response-paced gate spaces attempts after each response. In-flight concurrency
# is fixed at 1 for this release, and the route matrix stays disabled because it
# is billed per origin-destination pair rather than per request.
#
# 四件容易混为一谈的事，这里分开说：
#   * QPS 与并发上限（BAIDU_*_QPS / BAIDU_*_MAX_INFLIGHT）说的是"每秒能发几次、
#     同时几条在飞"；
#   * 单任务预算（请求体 facilities.maxPoiRequests，默认 1200、上限 1200）说的是
#     "一个任务最多花几次"；
#   * 应用日预算（BAIDU_PLACE_DAILY_BUDGET 及 fallback 档的那一个）说的是"这个应用
#     一天最多花几次"，记在 QUOTA_LEDGER_PATH 的账本里，重启不清零，按北京时间跨日；
#   * 百度账号的真实配额不在本账本里，也不由本文件决定。
# 2026-10-09 控制台核实到的账号权益（免费额度，余额 ¥0.00、未在线购买）：
#   地点检索                5 万次/天，10 QPS      ← 对应 /place/v3/around
#   步行路线规划(轻量)      0.5 万次/天，3 QPS     ← 对应 directionlite/v1/walking
# 因此本文件里的一切都不得超过这两个数：应用日预算 2000 是账号额度的 4%（把 96% 留给
# 浏览器 SDK、其他应用与人工调用），Place QPS 取 10、步行 QPS 取 3，与账号一致。
# 这些上限不是"留有余量"，而是能在上游直接失败的设置 —— 超配额只会换来错误码。
# 提高应用日预算属于业务决定（当前值已按运营者授权从 80 提到 2000），但任何情况下都不该
# 高于账号权益；app/config.py 的 VERIFIED_ENTITLEMENT 记录了核实到的数字。
# 两档现在参数相同（只保留切换点本身）：当初引入降级档的理由是"权益会失效"，而控制台显示
# 权益仍然有效，那个 20 倍的落差不再成立。
BAIDU_DIRECTION_QPS=3
BAIDU_PLACE_QPS=10
BAIDU_DIRECTION_MAX_INFLIGHT=1
BAIDU_PLACE_MAX_INFLIGHT=1
BAIDU_PLACE_DAILY_BUDGET=2000
BAIDU_MATRIX_ENABLED=false
# The instant the (now identical) tier would take over (an offset is required).
# Kept because removing a configuration surface is its own decision; it is where a
# future downgrade would be expressed.
BAIDU_QUOTA_FALLBACK_AT=2026-09-30T00:00:00+08:00
BAIDU_FALLBACK_DIRECTION_QPS=3
BAIDU_FALLBACK_PLACE_QPS=10
BAIDU_FALLBACK_PLACE_DAILY_BUDGET=2000
# 一次设施检索的首轮页数 = 几何确定后的查询分块数（最多 4）× 检索小类数。这是**首轮
# 估计**，不是总请求数的下界：翻页、细分与重试一定还要更多页；而命中缓存的页面不消耗
# 任何网络额度。/api/v2/capabilities 的 budgets.poiMinorCategories 报出小类数、
# budgets.poiBlocksUpperBound 报出分块上界；请求体里算不出实际分块数。
# 当前目录下核心三类（医疗/购物/教育）是 14 个小类：分块数为 4 时首轮约 56 页；全部十大类
# 是 31 个小类，约 124 页。按合成夹具实测的整轮派发（C0，见 evidence/07）：核心三类稀疏
# 59 次、适中 203 次、密集 1379 次。这些是历史采样参考；当前单任务默认 1200 能让"适中"一次查到 80%，
# 密集的要显式把 maxPoiRequests 提到上限附近才够；十类全查也仍然建议按需补查
# （POST /api/v2/checkups/{taskId}/facility-extensions）—— 它复用已算出的圈面，
# 只查本次明确选择的类别，也不改原报告的评分与修订。
# 补查与设施阶段的预检先看首轮有多少页已经在有效缓存里：完全可复用的补查在日余额为 0 时
# 也能提交，因为它一次都不会联网；预检结果随补查结果一起报出（initialPlan），
# 它是**执行前**（派发第一页之前）的估算，不是提交时的额度预留，也不承诺翻页与细分
# 跑在其中。
# 本地页面调度另有独立上限（默认 4096 步，与网络额度分开，见 capabilities 的
# poiPlanning.processingStepLimit）：缓存重放不占网络额度，因此不会因为"重放够多页"
# 而提前停下 —— 真正派发前的最终检查与原子扣减始终在服务池那一个点上。
# Durable daily application ledger (SQLite). Relative to backend/. The browser
# SDK and other applications are outside this ledger, so its balance is this
# application's own, not the account's remaining allowance.
QUOTA_LEDGER_PATH=.quota/quota.sqlite3

# Independent official coordinate conversion app limits (not account entitlement).
BAIDU_GEOCONV_QPS=1
BAIDU_GEOCONV_DAILY_BUDGET=100
