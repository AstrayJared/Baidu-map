# .command / .sh 是由 shebang 直接执行的脚本：必须保持 LF，
# 否则会变成 "#!/usr/bin/env bash\r"，内核找不到解释器而无法启动。
*.command text eol=lf
*.sh text eol=lf

# Windows 批处理必须保持 CRLF。
*.bat text eol=crlf

# Generated outputs are byte-pinned by backend/tools/export_contract.py.
# Preserve the historical CRLF blobs; v2 TypeScript is always LF, even when
# the checkout machine enables core.autocrlf.
/backend/docs/openapi.json -text
/backend/docs/analysis-response.schema.json -text
/backend/mocks/*.json -text
/life-circle-demo/src/api-contract.ts -text
/life-circle-demo/src/checkup/contract.ts text eol=lf
